# ===== 应用 =====
RAG_HOST=127.0.0.1
RAG_PORT=8000
# 数据目录单一来源：qdrant 路径与 sqlite 库默认由此派生（可用下方显式配置覆盖）
RAG_DATA_DIR=data

# ===== 向量库 =====
# 留空 => qdrant-client 本地嵌入模式（免 Docker，数据落 data/qdrant）
RAG_QDRANT_URL=
RAG_QDRANT_PATH=
# HNSW 索引参数（架构 §8.2）
RAG_HNSW_M=16
RAG_HNSW_EF_CONSTRUCT=200
RAG_HNSW_EF=256

# ===== 嵌入后端: stub | local | tei | openai =====
# stub    : 确定性哈希向量，零依赖，仅用于开发/测试
# local   : 本机加载 sentence-transformers（需 `uv sync --extra embed`，走 GPU）
# tei     : 远程 TEI 服务（生产推荐，127.0.0.1:9002）
# openai  : 任意 OpenAI 兼容 /v1/embeddings 端点（TEI 自带该兼容层）；必须配 RAG_OPENAI_API_KEY
RAG_EMBEDDING_BACKEND=stub
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DIM=1024
RAG_TEI_URL=http://127.0.0.1:9002
RAG_OPENAI_BASE_URL=http://127.0.0.1:9002/v1
RAG_OPENAI_API_KEY=

# ===== LLM（OpenAI 兼容端点；架构默认 vLLM 9001，Spike 后可能切 llama.cpp）=====
RAG_LLM_BASE_URL=http://127.0.0.1:9001/v1
RAG_LLM_API_KEY=
RAG_LLM_MODEL=Qwen3-8B-AWQ
RAG_LLM_TIMEOUT=120

# ===== 任务队列（ADR-002：本机 filesystem 代理；生产切 redis://）=====
RAG_CELERY_BROKER_URL=filesystem://

# ===== URL 摄取与 SSRF 防护（审计 F-10）=====
# 逗号分隔域名白名单；空 = 任意公网（解析后 IP 校验兜底）
RAG_URL_ALLOWLIST=
RAG_URL_FETCH_MAX_BYTES=5242880
RAG_URL_FETCH_MAX_REDIRECTS=3
RAG_URL_FETCH_TIMEOUT=15
# 仅测试/开发：允许本机地址；生产必须保持 false
RAG_URL_FETCH_ALLOW_LOOPBACK=false

# ===== 认证与上传防护 =====
# 服务主 API Key（Bearer）；留空 => fail-closed（业务接口全部拒绝，仅 /health 开放）
# 生成建议：python -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_API_KEY=
# 上传大小上限（MB）与 PDF 页数上限（防解析器资源耗尽）
RAG_MAX_UPLOAD_MB=200
RAG_MAX_PDF_PAGES=1000

# ===== 生成策略 =====
# 检索最高分低于该阈值时拒答（不调用 LLM；Phase 2 起按 KB 校准）
RAG_REFUSAL_THRESHOLD=0.25

# ===== 摄取与检索参数（Phase 0 用 chunk/HNSW；Phase 2 起用全量）=====
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_PARENT_CHUNK_SIZE=2048
RAG_RETRIEVAL_TOP_K=50
RAG_SEARCH_TOP_K=5
RAG_RERANK_TOP_K=8
RAG_RRF_K=60
RAG_EMBED_BATCH_SIZE=128
# 重排后端：off | tei（Phase 2 接入 bge-reranker-v2-m3）
RAG_RERANK_BACKEND=off
RAG_RERANK_URL=http://127.0.0.1:9003
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===== 元数据 =====
# 留空 => 派生为 sqlite:///{data_dir}/registry.db（MVP 用 SQLite，Phase 1+ 换 PostgreSQL + Alembic）
RAG_DATABASE_URL=
